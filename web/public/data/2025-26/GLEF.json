                  "instructor": "Professor Kevin Joseph Meredith DEVEREUX",
                  "dates": "5/9, 12/9, 19/9, 26/9, 3/10, 10/10, 17/10, 24/10, 31/10, 7/11, 14/11, 21/11, 28/11"
                }
              ],
              "availability": {
                "capacity": "41",
                "enrolled": "36",

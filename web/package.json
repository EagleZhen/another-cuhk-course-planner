    "lucide-react": "^1.60.0",
    "modern-screenshot": "^4.7.0",
    "moment-timezone": "^0.6.5",
    "next": "^16.4.3",
    "posthog-js": "^1.438.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
